# Omni Release backend secrets — SERVER-ONLY. Never ship these in the desktop app.
# Copy to .env and fill in. .env is gitignored.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # service role bypasses RLS — server/worker only

# --- Token vault ---
# 32-byte base64 key. Generate once with:  npm run keygen
TOKEN_ENC_KEY=

# --- OAuth redirect (your deployed callback Edge Function) ---
OAUTH_REDIRECT_URI=https://<project-ref>.functions.supabase.co/oauth-callback

# --- Platform OAuth client credentials (add only as you build each platform) ---
# YouTube (Phase 2) — Google Cloud OAuth 2.0 client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta (Phase 3) — one app for Facebook + Instagram
META_APP_ID=
META_APP_SECRET=

# TikTok (Phase 4)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X / Twitter (Phase 5) — verify paid tier first
X_CLIENT_ID=
X_CLIENT_SECRET=

# Twitch (Phase 6)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
