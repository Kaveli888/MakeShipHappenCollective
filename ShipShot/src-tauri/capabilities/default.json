{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ShipShot main-window permissions",
  "windows": ["main", "quick-access", "annotation"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/ShipMemory" },
        { "path": "$HOME/ShipMemory/**" },
        { "path": "$PICTURE/ShipShot" },
        { "path": "$PICTURE/ShipShot/**" }
      ],
      "requireLiteralLeadingDot": false
    },
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister-all",
    "drag:default"
  ]
}
