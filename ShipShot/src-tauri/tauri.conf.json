{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShipShot",
  "version": "0.1.4",
  "identifier": "com.makeshiphappen.shipshot",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ShipShot",
        "width": 1240,
        "height": 790,
        "minWidth": 900,
        "minHeight": 650,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      },
      {
        "label": "quick-access",
        "title": "ShipShot Quick Access",
        "url": "index.html?window=quick-access",
        "width": 200,
        "height": 125,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "annotation",
        "title": "Annotate with ShipShot",
        "url": "index.html?window=annotation",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; img-src 'self' asset: blob: data:; media-src 'self' asset: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$PICTURE/ShipShot/**", "$HOME/ShipMemory/**", "$APPCACHE/pending/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Capture anything. Remember everything.",
    "longDescription": "A local-first screen capture utility connected to Ship Memory.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Developer ID Application: Jacob Felton (7G7K3X24Q5)",
      "infoPlist": "Info.plist"
    }
  }
}
