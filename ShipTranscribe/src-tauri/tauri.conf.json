{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/main/nicegui/static/tauri.schema.json",
  "productName": "ShipTranscript",
  "version": "0.1.0",
  "identifier": "com.makeshiphappen.shiptranscribe",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ShipTranscript",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; img-src 'self' asset: blob: data:; media-src 'self' asset: blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwNjAwQTRFNUMzNDMxNzcKUldSM01UUmNUZ3BnNERCUDAwd3FPOEJXZ3kreXU3ZnVEd1NrSHdOeEhVUlNKTXNUemdmdkVTaW8K",
      "endpoints": [
        "https://github.com/MakeShipHappenCollective/ShipTranscribe/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
