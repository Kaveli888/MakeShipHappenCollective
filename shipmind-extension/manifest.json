{
  "manifest_version": 3,
  "name": "ShipMind",
  "version": "0.1.0",
  "description": "Send any link, page, or selection to ShipMind with one right-click.",
  "permissions": ["contextMenus", "storage", "notifications", "tabs"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShipMind"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
